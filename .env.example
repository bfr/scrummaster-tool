# --- Azure Foundry (see azure-llm-template) ---
# Ask the project owner for both values (never commit them)
AOAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_API_KEY=
# Optional: fixed model list instead of looking up deployments, e.g. gpt-5-mini,gpt-5
# AZURE_MODELS=
DEFAULT_MODEL=gpt-5-mini

# --- Atlassian MCP (https://github.com/annadruid/jira-to-confluence) ---
# Folder with the cloned + `npm install`ed MCP server (it reads its own .env for Atlassian/Tempo tokens)
JIRA_MCP_DIR=./mcp/jira-to-confluence
# Set to true to also expose tools that create/update/delete things. Default: read-only tools only.
ALLOW_WRITE_TOOLS=false

PORT=3000
